# Copy to .env.local for local development, and set the same names in the
# hosting provider (Vercel -> Project -> Settings -> Environment Variables).
# Never put real values in this file: it is committed to git.

# --- Required -------------------------------------------------------------

# MongoDB connection string and database name.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
DATABASE_NAME=mookalaa

# Signs admin and app sessions. At least 32 random characters. Admin sign-in
# is refused in production while this is missing.
JWT_SECRET=

# Encrypts saved secrets (Razorpay key secret, webhook secret, SMS API key,
# 2FA secrets). Changing it makes saved secrets unreadable: they must then be
# entered again in the admin panel. Falls back to JWT_SECRET when empty.
SETTINGS_ENCRYPTION_KEY=

# --- Sign-in for the apps and website ---------------------------------------

# "enforce": every app call that acts on a phone number needs a session token.
# Leave empty while app builds that do not send a token are still in use.
APP_AUTH_MODE=

# Development only. When "true" and no SMS provider is saved in the admin
# panel, the code 1234 signs in to any phone. MUST be empty in production.
ALLOW_DEV_OTP=

# --- Payments ----------------------------------------------------------------

# Razorpay keys are saved in the admin panel (Finance -> Payment Gateway).
# These two are only a fallback used until keys are saved there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# "allow": tickets that were never confirmed with the payment gateway are
# still created and admitted at the gate. For demonstrations only.
LEGACY_UNVERIFIED_BOOKINGS=

# --- Scheduled reports -----------------------------------------------------

# Vercel Cron calls /api/cron/reports with this value as a Bearer token.
# At least 16 random characters. Scheduled reports do not run without it.
CRON_SECRET=
